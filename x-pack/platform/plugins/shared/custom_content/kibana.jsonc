{
  "type": "plugin",
  "id": "@kbn/custom-content-plugin",
  "owner": ["@elastic/kibana-dashboards"],
  "group": "platform",
  "visibility": "shared",
  "description": "Custom content embeddable for dashboards",
  "plugin": {
    "id": "customContent",
    "browser": true,
    "server": true,
    "requiredBundles": ["charts"],
    "requiredPlugins": [
      "embeddable",
      "data",
      "esql",
      "inspector",
      "uiActions"
    ],
    "optionalPlugins": [
      "agentBuilder"
    ]
  }
}
